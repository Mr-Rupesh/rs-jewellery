# --- Firebase (client) ---
NEXT_PUBLIC_FIREBASE_API_KEY=demo-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-rs-jewellers.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-rs-jewellers
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=demo-rs-jewellers.appspot.com
NEXT_PUBLIC_USE_EMULATORS=true
# (Server auto-uses emulator hosts 127.0.0.1:8080 / :9099 when the flag above is true)

# --- Firebase Admin (server). Not needed while using emulators. ---
FIREBASE_SERVICE_ACCOUNT_JSON=

# --- Razorpay (TEST keys only until go-live) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=localsecret123

# --- Shop details (invoice, footer, policy pages). Leave GSTIN empty if you are not GST-registered. ---
NEXT_PUBLIC_SHOP_NAME=R S Jewellers
NEXT_PUBLIC_SHOP_ADDRESS=12/16A, Old Hanuman Gali, 1st Cross Lane, 2nd Floor, Room No. 19, Kalbadevi Road, Mumbai 400002
NEXT_PUBLIC_SHOP_STATE=Maharashtra
NEXT_PUBLIC_SHOP_GSTIN=
NEXT_PUBLIC_SHOP_PHONE=9967551801
NEXT_PUBLIC_SHOP_EMAIL=satheramesh112@gmail.com

# --- Floating WhatsApp button (digits only, with country code). WhatsApp messages to customers are sent by hand from the admin screens. ---
NEXT_PUBLIC_WHATSAPP_NUMBER=919322392769

# Phone OTP login is switched off. Set to true to show the phone login box again (needs paid Firebase SMS).
NEXT_PUBLIC_ENABLE_PHONE_LOGIN=false

# --- Email login codes (server only). OTP_SECRET: any long random text (e.g. run: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))") ---
OTP_SECRET=
# Resend (resend.com). Leave both empty while developing: the code is then printed in the `npm run dev` terminal.
RESEND_API_KEY=
EMAIL_FROM=RS Jewellers <login@your-domain.com>

# --- Admins in production: emails that become admin automatically after they log in (comma separated). Keep it a secret. ---
ADMIN_EMAILS=
# Safety switch: a production build refuses to start with emulators on. Set true ONLY to test a production build on your own computer.
ALLOW_EMULATORS_IN_PRODUCTION=false
